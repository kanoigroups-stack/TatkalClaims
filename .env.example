NEXT_PUBLIC_SANITY_PROJECT_ID=ah5vm288
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-27

# Server-only read token for /cms-preview/ draft access.
# Never prefix this with NEXT_PUBLIC_ and never commit an actual token.
SANITY_PREVIEW_TOKEN=

# Server-only HTTP Basic Auth protecting /cms-preview/.
CMS_PREVIEW_USERNAME=
CMS_PREVIEW_PASSWORD=


# Google AdSense. Disabled unless the flag is true and all required IDs are valid.
# Publisher/client and slot IDs are public identifiers, not secrets.
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_ARTICLE_PRIMARY_SLOT=
NEXT_PUBLIC_ADSENSE_ARTICLE_SECONDARY_SLOT=
